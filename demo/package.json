{
  "name": "v-intl-demo",
  "version": "0.0.0",
  "private": true,
  "description": "Live demo of @vinayakkulkarni/v-intl on Cloudflare Workers",
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt build && wrangler dev --config .output/server/wrangler.json",
    "deploy": "nuxt build && wrangler deploy --config .output/server/wrangler.json",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt prepare && vue-tsc -b --noEmit"
  },
  "dependencies": {
    "@nuxtjs/color-mode": "^4.1.0",
    "@vinayakkulkarni/v-intl": "workspace:*",
    "nuxt": "^4.6.4",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.14",
    "wrangler": "^4.159.0"
  }
}
