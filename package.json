{
  "name": "@vinayakkulkarni/v-intl",
  "version": "4.0.2",
  "private": false,
  "description": "Native Intl-based i18n components for Vue 3 — number, date, currency, relative time, and list formatting with zero runtime overhead.",
  "keywords": [
    "internationalization",
    "intl",
    "v-intl",
    "vue",
    "vue intl"
  ],
  "homepage": "https://v-intl.vinayakkulkarni.dev",
  "bugs": {
    "url": "https://github.com/vinayakkulkarni/v-intl/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Vinayak Kulkarni",
    "email": "inbox.vinayak@gmail.com",
    "url": "https://vinayakkulkarni.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vinayakkulkarni/v-intl.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "typecheck": "vue-tsc --noEmit && vue-tsc --noEmit -p tests && pnpm run build && pnpm --filter v-intl-demo run typecheck",
    "build": "vp pack",
    "test": "vp test run",
    "demo:dev": "pnpm run build && pnpm --filter v-intl-demo run dev",
    "demo:build": "pnpm run build && pnpm --filter v-intl-demo run build",
    "deploy": "pnpm run demo:build && pnpm --filter v-intl-demo run deploy",
    "prepare": "is-ci || husky"
  },
  "dependencies": {
    "@formatjs/intl-durationformat": "^0.11.1",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^26.6.5",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "lint-staged": "^17.6.0",
    "typescript": "^6.0.3",
    "unplugin-vue": "^8.0.0",
    "vite-plus": "^1.4.0",
    "vue-tsc": "^3.3.13"
  },
  "peerDependencies": {
    "vue": "^3.5.27"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26.x"
    }
  },
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61"
}
